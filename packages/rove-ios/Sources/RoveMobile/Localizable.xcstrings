      "shouldTranslate" : false
    },
    "A label only: the worktree, branch and session stay as they are. Canceled stops nothing; delete the task to end it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只是一个标签：worktree、分支和会话保持不变。canceled 不会停止任何东西；要结束任务请删除它。"
          }
        }
      }
    },
    "A worktree with uncommitted changes is refused until you confirm again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有未提交改动的 worktree 会被拒绝，需再次确认。"
          }
        }
      }
    },
    "Also discard uncommitted changes" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同时丢弃未提交的改动"
