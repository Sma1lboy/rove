    "Shell tabs and plugin panes need a desktop terminal, so the phone starts engines only." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell 标签页和插件面板需要桌面终端，手机端只能启动引擎。"
          }
        }
      }
    },
    "Shown in the tab strip here and on the desktop." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示在此处和桌面端的标签栏。"
