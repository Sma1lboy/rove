    "The child branches from %@: committed work carries over, uncommitted changes stay behind." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "子任务从 %@ 分出：已提交的工作会带过去，未提交的改动留在原处。"
          }
        }
      }
    },
    "The issue body becomes the first prompt, marked as an untrusted report. Nothing is written back to GitHub." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
