{
  "name": "rove-bridge",
  "version": "0.0.35",
  "description": "Mac-side WebSocket bridge between the Rove daemon and its phone and browser clients. Off unless started.",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol.ts"
  },
  "scripts": {
    "dev": "bun run src/dev.ts",
    "start": "bun src/main.ts",
    "test": "bun test test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hsinsekai-nanami/agent": "0.2.4",
    "@hsinsekai-nanami/core": "0.2.2",
    "@sma1lboy/rove": "workspace:*",
    "@sma1lboy/rove-daemon": "workspace:*",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@hsinsekai-nanami/client": "0.2.4",
    "@tsconfig/bun": "1.0.11",
    "@types/bun": "1.3.14",
    "@types/node": "25.6.2",
    "typescript": "5.8.2"
  }
}
