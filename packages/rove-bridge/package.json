{
  "name": "rove-bridge",
  "version": "0.0.6",
  "description": "Mac-side WebSocket bridge between the Rove daemon and the Rove iOS client. Off unless started.",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "bun run src/dev.ts",
    "start": "bun src/main.ts",
    "test": "bun test test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sma1lboy/rove": "workspace:*",
    "@sma1lboy/rove-daemon": "workspace:*",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.11",
    "@types/bun": "1.3.14",
    "@types/node": "25.6.2",
    "typescript": "5.8.2"
  }
}
