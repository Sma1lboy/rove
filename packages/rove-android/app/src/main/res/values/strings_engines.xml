    <string name="engines_prose_default_off">Makes %1$s the engine new tasks start with. It is switched off, so this switches it back on.</string>
    <string name="engines_prose_rename_clear">Clears the name override: %1$s goes back to its built-in name. The launch command stays.</string>
    <string name="engines_prose_rename">Renames %1$s to “%2$s” on the mac and in this app. The launch command stays.</string>
    <string name="engines_prose_remove">Removes the custom engine %1$s: its launch command, name and protocol are deleted from the mac.</string>
    <string name="engines_prose_reset">Clears the name and launch-command overrides for %1$s. It goes back to its built-in settings; on or off stays as it is.</string>
